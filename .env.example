# DocSplit — Variáveis de Ambiente

# ========================================
# OPENROUTER (Classificação via LLM)
# ========================================
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_MODEL=openai/gpt-4o-mini

# ========================================
# SUPABASE (Banco de Dados + Auth)
# ========================================
# Painel: https://supabase.com/dashboard/project/SEU_PROJECT/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...sua-service-role-key

# ========================================
# MERCADO PAGO (Pagamentos)
# ========================================
# Produção: https://www.mercadopago.com.br/developers/panel/app
# Teste: usar access_token de sandbox
MERCADOPAGO_ACCESS_TOKEN=APP_USR-sua-chave-producao
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key

# Teste (sandbox)
# MERCADOPAGO_ACCESS_TOKEN=TEST-sua-chave-teste
# MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key-teste

# ========================================
# FRONTEND (URL base)
# ========================================
# Local: http://localhost:5173
# Produção: https://docsplit.vercel.app
FRONTEND_URL=http://localhost:5173

# ========================================
# BACKEND (URL da API)
# ========================================
# Local: http://localhost:8000
# Produção: https://docsplit-api.railway.app
BACKEND_URL=http://localhost:8000

# ========================================
# OCR (Opcional — só localmente)
# ========================================
OCR_DPI=180
OCR_LANGUAGE=por
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.8
