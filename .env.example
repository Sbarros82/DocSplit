# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env de verdade.

ANTHROPIC_API_KEY=sk-ant-...

# Limiar de confiança abaixo do qual o classificador cai no fallback de LLM
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.8

# Idioma do OCR (Tesseract)
OCR_LANGUAGE=por

# Pastas padrão
DEFAULT_INPUT_DIR=data/input
DEFAULT_OUTPUT_DIR=data/output

# Caminho opcional para tessdata (por.traineddata)
# PDF_SPLITTER_TESSDATA=C:\Users\SeuUsuario\AppData\Local\pdf_splitter\tessdata

