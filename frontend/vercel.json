{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/upload", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/finance", "destination": "/index.html" },
    { "source": "/admin/logs", "destination": "/index.html" },
    { "source": "/admin/blog", "destination": "/index.html" },
    { "source": "/payment/:path*", "destination": "/index.html" }
  ]
}
